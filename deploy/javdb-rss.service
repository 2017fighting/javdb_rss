# systemd 部署示例。
#
# 安装：
#   sudo install -m 0755 javdb-rss /usr/local/bin/javdb-rss
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin javdb-rss
#   sudo install -d -o javdb-rss -g javdb-rss -m 0750 /etc/javdb-rss
#   sudo install -o javdb-rss -g javdb-rss -m 0640 config.example.yaml /etc/javdb-rss/config.yaml
#   sudo $EDITOR /etc/javdb-rss/config.yaml
#
# ⚠️ 必须改一处：把 app_api.pin_file 指到状态目录。
#   config.example.yaml 里的 pin_file 是 ""，而空值时 pin 默认落在**配置文件旁边**
#   （/etc/javdb-rss/pin.json）—— 但本 unit 把 /etc/javdb-rss 设为只读，
#   于是服务会**拒绝启动**（这是刻意的：宁可看见错误）。改成：
#       app_api:
#         pin_file: "/var/lib/javdb-rss/pin.json"
#   那个目录由下面的 StateDirectory=javdb-rss 创建并已可写。
#   # 若要读 App 里的收藏女优，需要 token。**以服务用户身份**登录，
#   # 这样写出的 token.json（0600）属主就是它：
#   sudo -u javdb-rss /usr/local/bin/javdb-rss login -config /etc/javdb-rss/config.yaml
#
#   sudo cp deploy/javdb-rss.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now javdb-rss
#
# 改完配置后重载（不用重启进程）：
#   sudo systemctl reload javdb-rss
#
# 看日志：
#   journalctl -u javdb-rss -f

[Unit]
Description=JavDB App 订阅 → RSS
Documentation=https://github.com/2017fighting/javdb_rss
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/javdb-rss -config /etc/javdb-rss/config.yaml
# SIGHUP 触发配置热重载与 pin 表重读（写坏的配置/状态会被拒绝，旧的继续生效）
ExecReload=/bin/kill -HUP $MAINPID

# --- 加固 ---------------------------------------------------------------
# 本服务只需要读自己的配置与 token，然后往外发 HTTPS 请求。
# 它可以被削到很窄的权限面。

# ⚠️ 这里刻意**不用** DynamicUser=yes。
#
# 曾经用过，但那与 token 文件直接冲突：动态分配的瞬态 UID 对 root 拥有的
# 0600 文件属于 other，打开必得 EACCES；而 ReadOnlyPaths 不能绕过 Linux DAC 权限，
# 管理员也没法预先 chown 给一个还不存在的 UID。结果是「配了 token 就起不来」。
#
# 改用普通系统用户（由安装步骤创建），安装时把配置目录的属主给它。
# 代价是多一步 useradd；换来的是权限模型可推理、可审计。
User=javdb-rss
Group=javdb-rss

# 文件系统：只读整个系统，只额外允许读配置与 token，并给一个可写状态目录。
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/javdb-rss

# ⭐ 状态目录：pin 表（「每个作品已选中的磁链」）落在这里。
#
# StateDirectory 由 systemd 创建 /var/lib/javdb-rss、把它 chown 给服务用户，
# 并在 ProtectSystem=strict 下**自动把它列为可写** —— 不需要额外的
# ReadWritePaths。目录会在服务停止后保留（不是 /run 那种易失目录）。
#
# 为什么必须持久：丢掉 pin 会让服务按规则重新选磁链 → 约 1/4 的作品
# guid 变化 → qBittorrent 各自再下一份，且没有任何告警（见 ticket 08）。
#
# 配置里对应的键是 app_api.pin_file（本部署取 /var/lib/javdb-rss/pin.json）。
StateDirectory=javdb-rss
PrivateTmp=yes
PrivateDevices=yes
# 核心转储里可能带上 token，关掉。
LimitCORE=0

# 内核面
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# 命名空间 / 网络
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# 本服务是一个纯 HTTP 客户端 + 服务端，不需要这些特权操作。
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# 能力：全清。绑 8080 不需要 CAP_NET_BIND_SERVICE
# （只有 <1024 的端口才需要，见配置里为何默认 8080）。
CapabilityBoundingSet=
AmbientCapabilities=

# --- 资源 ---------------------------------------------------------------
# 单个 Go 二进制很轻；设个上限防止异常时把机器拖慢。
MemoryMax=128M
TasksMax=64

# --- 重启 ---------------------------------------------------------------
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
