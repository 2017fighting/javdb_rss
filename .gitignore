# ---------------------------------------------------------------------------
# 逆向目标二进制 —— 不入库
#
# APK 有 34 MB，且是第三方发行物，提交进 git 会永久留在历史里。
# 需要时按下面的指纹重新获取：
#
#   jdb_official_v1.9.35.apk
#   sha256 = 3616335e465afe5f57376080ddd211ae61aad77e44ecf8aec9cb819deeea4a5e
#   size   = 34140434 bytes
#
# 见 .scratch/javdb-rss/notes/api-recon.md 获取来源说明。
# ---------------------------------------------------------------------------
*.apk
*.apks
*.xapk
*.aab

# 逆向产物（解包出来的 so / dex / Dart snapshot dump 都是几十 MB 起，
# 且可由上面的 APK 确定性重建）
/extracted/
/unpacked/
/dumps/
/snapshot/
*.dex
*.smali
libapp.so
libsecurity.so
libflutter.so

# ---------------------------------------------------------------------------
# 密钥与凭据 —— 绝不入库
#
# 手工导出的 App token 存在本地，不要提交。
# ---------------------------------------------------------------------------
# token 文件（login 写入；token_file 留空时默认就在配置文件旁边）
token.json
token.txt
# 本地配置文件：README 让用户 cp config.example.yaml config.yaml，
# 而它可能带上 token 路径或（若启用自动续期）凭据
config.yaml
# 本地构建产物
/javdb-rss
secrets.yaml
secrets.yml
config.local.yaml
config.local.yml
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# 本地探手与调试产物
#
# 注意：`*.xml` 是因为验证 feed 时习惯用 curl -o 存到当前目录，
# 曾经真的把测试文件提交进仓库。本项目自己不产出 xml 文件（feed 是现算的）。
# ---------------------------------------------------------------------------
*.xml
*.log

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
/bin/
/dist/
*.exe
*.test
*.out
coverage.txt
coverage.html

# ---------------------------------------------------------------------------
# Python（逆向脚本用；服务本身是 Go）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
uv.lock.bak

# ---------------------------------------------------------------------------
# 编辑器 / 操作系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*~

# 注意：.scratch/ 故意 **不** 忽略。
# wayfinder 地图（.scratch/javdb-rss/map.md）与 ticket 是本 effort 的
# 正式产物，需要跨 session、跨机器共享。
